.hint{min-height:25px;color:#ffb9d0;font-size:14px}
.hidden{display:none!important}
.love{font-size:clamp(27px,6vw,40px);font-weight:bold;color:#ffd4e3;line-height:1.4;margin:24px 0;animation:appear .8s ease both}
.envelope{font-size:72px;animation:float 2s ease-in-out infinite}
.letter{margin-top:25px;text-align:left;white-space:pre-line;line-height:1.85;font-size:17px;color:#4b263b;background:#fff0f5;border-radius:18px;padding:clamp(18px,4vw,28px);box-shadow:inset 0 0 0 1px #e9b7ca}
.letter-title{text-align:center;color:#a33e68;font-size:25px;margin-bottom:18px;font-weight:bold}
.tiny{font-size:13px;color:#d9b9d0;margin-top:22px}
@keyframes appear{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
@keyframes float{50%{transform:translateY(-8px)}}
