<title>Для тебя ❤️</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;color:#fff;font-family:Georgia,"Times New Roman",serif;background:radial-gradient(ellipse at top,#542443,#24152f 55%,#100d20);display:flex;align-items:center;justify-content:center;padding:22px}
.glow{position:fixed;width:260px;height:260px;border-radius:50%;filter:blur(90px);opacity:.22;pointer-events:none;background:#ff4f91;top:5%;left:-100px}
.glow.two{background:#9b64ff;top:auto;left:auto;right:-100px;bottom:4%}
.card{width:min(100%,650px);position:relative;text-align:center;padding:clamp(25px,6vw,46px);border:1px solid #ffffff25;border-radius:28px;background:linear-gradient(145deg,#ffffff14,#ffffff08);box-shadow:0 22px 80px #0008;backdrop-filter:blur(12px)}
.crown{font-size:40px;margin-bottom:12px}
h1{font-size:clamp(27px,6vw,39px);line-height:1.2;margin:0 0 16px}
p{font-size:17px;line-height:1.7;color:#f1dce9}
input{width:100%;max-width:320px;padding:15px;border-radius:14px;border:1px solid #ffffff45;background:#160f26;color:white;font:17px Arial;text-align:center;color-scheme:dark;margin:15px auto}
button{border:0;border-radius:999px;padding:14px 27px;margin-top:14px;color:#32152b;background:linear-gradient(100deg,#ffd0df,#ff83ad);font-size:16px;font-weight:bold;cursor:pointer;box-shadow:0 8px 25px #ff6c9c35}
